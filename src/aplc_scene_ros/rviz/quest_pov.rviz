Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 40
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: false
      Cell Size: 1
      Plane Cell Count: 40
    - Class: rviz_default_plugins/MarkerArray
      Name: Captured scene
      Enabled: true
      Topic:
        Value: /scene/markers
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Name: Live Quest
      Enabled: false
      Topic:
        Value: /quest/markers
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Name: Quest trail
      Enabled: false
      Topic:
        Value: /quest/trail
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: aplc_scene_ros/QuestPOV
      Name: Quest POV
      Target Frame: quest_headset
      Position:
        X: 0
        Y: 0
        Z: 0
      Yaw: 0
      Pitch: 0
      Near Clip Distance: 0.05
      Vertical FOV: 75
Window Geometry:
  Width: 960
  Height: 720
  X: 650
  Y: 80
