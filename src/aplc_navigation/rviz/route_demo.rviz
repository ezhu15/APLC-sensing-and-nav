# RViz view for launch/route_demo.launch.py.
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Tree Height: 400
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Value: true
    Cell Size: 1
    Plane Cell Count: 30
    Color: 160; 160; 164
    Alpha: 0.4
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/Map
    Name: Global costmap
    Enabled: true
    Value: true
    Alpha: 0.5
    Color Scheme: costmap
    Draw Behind: true
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/costmap
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/costmap_updates
  - Class: rviz_default_plugins/Map
    Name: Local costmap
    Enabled: true
    Value: true
    Alpha: 0.6
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/costmap
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/costmap_updates
  - Class: rviz_default_plugins/RobotModel
    Name: Robot
    Enabled: true
    Value: true
    Description Source: Topic
    Description Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot_description
    Visual Enabled: true
    Collision Enabled: false
  - Class: rviz_default_plugins/MarkerArray
    Name: Route graph (named, active route orange)
    Enabled: true
    Value: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /route_graph_viz
  - Class: rviz_default_plugins/MarkerArray
    Name: Route graph (Route Server, node ids)
    Enabled: false
    Value: false
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /route_graph
  - Class: rviz_default_plugins/Path
    Name: Route path (Route Server)
    Enabled: true
    Value: true
    Color: 0; 200; 255
    Line Style: Billboards
    Line Width: 0.05
    Alpha: 1
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /plan
  - Class: rviz_default_plugins/MarkerArray
    Name: MPPI samples
    Enabled: false
    Value: false
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /trajectories
  - Class: rviz_default_plugins/Path
    Name: MPPI optimal
    Enabled: true
    Value: true
    Color: 255; 200; 0
    Line Style: Lines
    Alpha: 1
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /optimal_trajectory
  - Class: rviz_default_plugins/PointCloud2
    Name: Depth cloud (headset)
    Enabled: true
    Value: true
    Size (m): 0.03
    Style: Points
    Size (Pixels): 2
    Color Transformer: AxisColor
    Axis: Z
    Autocompute Value Bounds: false
    Min Value: 0.0
    Max Value: 1.2
    Alpha: 0.2
    Decay Time: 0
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /camera/camera/depth/color/points
  - Class: rviz_default_plugins/Pose
    Name: Quest pose
    Enabled: true
    Value: true
    Shape: Arrow
    Color: 25; 200; 255
    Shaft Length: 0.4
    Head Length: 0.15
    Shaft Radius: 0.03
    Head Radius: 0.07
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /quest/pose
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Value: false
    Show Names: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 15
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: nav2_rviz_plugins/GoalTool
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 15.0
      Focal Point:
        X: 2.2
        Y: 0.0
        Z: 0.0
      Pitch: 1.0
      Yaw: 3.6
      Value: Orbit (rviz)
    Saved: null
Window Geometry:
  Height: 900
  Width: 1400
