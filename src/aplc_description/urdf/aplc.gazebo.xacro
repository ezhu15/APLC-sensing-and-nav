<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Gazebo-only tags, included by aplc.urdf.xacro. gz_ros2_control drives
       the wheel joints by velocity; the controllers are configured in
       aplc_control/config/controllers.yaml. -->
  <xacro:macro name="wheel_interfaces" params="name">
    <joint name="${name}_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:wheel_interfaces name="front_left"/>
    <xacro:wheel_interfaces name="front_right"/>
    <xacro:wheel_interfaces name="rear_left"/>
    <xacro:wheel_interfaces name="rear_right"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find aplc_control)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- GROUND TRUTH: FOR EVALUATION ONLY. NEVER AN EKF (OR ANY ESTIMATOR) INPUT.
       Gazebo's exact pose and velocity of base_footprint in the world, as
       nav_msgs/Odometry on /ground_truth/odom (bridged in aplc_gazebo/config/bridge.yaml).
       The frame is ground_truth_world, deliberately not odom, so it can never be mistaken
       for or merged with the EKF's odom frame. Its TF topic stays inside Gazebo (not
       bridged), so it adds nothing to /tf. dimensions 3 keeps z, roll and pitch (the ramp).
       The pose is world-referenced (it starts at the spawn pose); to compare with the
       EKF, express it relative to its first pose. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>ground_truth_world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
      <gaussian_noise>0</gaussian_noise>
      <odom_topic>ground_truth/odom</odom_topic>
      <tf_topic>ground_truth/tf</tf_topic>
    </plugin>
  </gazebo>
</robot>
