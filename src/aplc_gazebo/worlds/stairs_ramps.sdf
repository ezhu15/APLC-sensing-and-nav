<?xml version="1.0" ?>
<!-- APLC test world: staircase (5 x 18 cm rise, 28 cm run, open sides) and two ramps (5 deg, 10 deg).
     Robot spawn area: origin, facing +x. Staircase at y=-3, 5 deg ramp at y=0, 10 deg ramp at y=+3.
     5 deg ramp rises 0.35 m, 10 deg ramp rises 0.52 m, stair landing at 0.90 m. -->
<sdf version="1.9">
  <world name="stairs_ramps">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <model name="stair_up_1">
      <static>true</static>
      <pose>2.1400 -3.0000 0.0900 0.0000 0.0000 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2800 1.2000 0.1800</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2800 1.2000 0.1800</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="stair_up_2">
      <static>true</static>
      <pose>2.4200 -3.0000 0.1800 0.0000 0.0000 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2800 1.2000 0.3600</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2800 1.2000 0.3600</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="stair_up_3">
      <static>true</static>
      <pose>2.7000 -3.0000 0.2700 0.0000 0.0000 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2800 1.2000 0.5400</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2800 1.2000 0.5400</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="stair_up_4">
      <static>true</static>
      <pose>2.9800 -3.0000 0.3600 0.0000 0.0000 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2800 1.2000 0.7200</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2800 1.2000 0.7200</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="stair_up_5">
      <static>true</static>
      <pose>3.2600 -3.0000 0.4500 0.0000 0.0000 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2800 1.2000 0.9000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2800 1.2000 0.9000</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="stair_landing">
      <static>true</static>
      <pose>4.0000 -3.0000 0.4500 0.0000 0.0000 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2000 1.2000 0.9000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2000 1.2000 0.9000</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="stair_down_1">
      <static>true</static>
      <pose>4.7400 -3.0000 0.3600 0.0000 0.0000 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2800 1.2000 0.7200</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2800 1.2000 0.7200</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="stair_down_2">
      <static>true</static>
      <pose>5.0200 -3.0000 0.2700 0.0000 0.0000 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2800 1.2000 0.5400</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2800 1.2000 0.5400</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="stair_down_3">
      <static>true</static>
      <pose>5.3000 -3.0000 0.1800 0.0000 0.0000 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2800 1.2000 0.3600</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2800 1.2000 0.3600</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="stair_down_4">
      <static>true</static>
      <pose>5.5800 -3.0000 0.0900 0.0000 0.0000 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2800 1.2000 0.1800</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2800 1.2000 0.1800</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="ramp_5deg_up">
      <static>true</static>
      <pose>3.9967 0.0000 0.1245 0.0000 -0.0873 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.0000 1.2000 0.1000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.0000 1.2000 0.1000</size></box></geometry>
          <material><ambient>0.3 0.55 0.3 1</ambient><diffuse>0.3 0.55 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="ramp_5deg_platform">
      <static>true</static>
      <pose>6.7348 0.0000 0.1743 0.0000 0.0000 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5000 1.2000 0.3486</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5000 1.2000 0.3486</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="ramp_5deg_down">
      <static>true</static>
      <pose>9.4728 0.0000 0.1245 0.0000 0.0873 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.0000 1.2000 0.1000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.0000 1.2000 0.1000</size></box></geometry>
          <material><ambient>0.3 0.55 0.3 1</ambient><diffuse>0.3 0.55 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="ramp_10deg_up">
      <static>true</static>
      <pose>3.4859 3.0000 0.2112 0.0000 -0.1745 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0000 1.2000 0.1000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.0000 1.2000 0.1000</size></box></geometry>
          <material><ambient>0.6 0.45 0.25 1</ambient><diffuse>0.6 0.45 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <model name="ramp_10deg_platform">
      <static>true</static>
      <pose>5.7044 3.0000 0.2605 0.0000 0.0000 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5000 1.2000 0.5209</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5000 1.2000 0.5209</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="ramp_10deg_down">
      <static>true</static>
      <pose>7.9230 3.0000 0.2112 0.0000 0.1745 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0000 1.2000 0.1000</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.0000 1.2000 0.1000</size></box></geometry>
          <material><ambient>0.6 0.45 0.25 1</ambient><diffuse>0.6 0.45 0.25 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
