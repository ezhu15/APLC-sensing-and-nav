<?xml version="1.0" ?>
<!-- APLC test world: house with raised floor, landing and straight ramp to the door.
     Generated by gen_house_world.py. Parameters:
       rise 0.45 m, slope 1:12 (4.76 deg), ramp run 5.40 m,
       ramp width 1.20 m, landing 1.20 x 1.50 m, ramp side right, house primitive, car suv
     Suggested robot spawn (on the landing, facing the ramp): x 0.60  y 3.50  z 0.55  yaw -90 deg
     Ramp foot at y -2.65; driveway centered at y -3.40, x 2.0 to 14.0. -->
<sdf version="1.9">
  <world name="house_ramp">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
